{
  "dns": {
    "final": "dns-remote",
    "rules": [
      {
        "domain": [
          "localhost"
        ],
        "domain_suffix": [
          "localhost",
          "local",
          "lan",
          "internal",
          "home.arpa"
        ],
        "server": "dns-local"
      }
    ],
    "servers": [
      {
        "detour": "proxy",
        "server": "1.1.1.1",
        "tag": "dns-remote",
        "type": "https"
      },
      {
        "server": "223.5.5.5",
        "tag": "dns-local",
        "type": "https"
      }
    ]
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "secret": "SECRET"
    }
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "listen_port": 10808,
      "tag": "socks-in",
      "type": "socks"
    },
    {
      "listen": "127.0.0.1",
      "listen_port": 10809,
      "tag": "http-in",
      "type": "http"
    }
  ],
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "outbounds": [
    {
      "password": "pw",
      "server": "1.2.3.4",
      "server_port": 443,
      "tag": "proxy",
      "tls": {
        "enabled": true,
        "server_name": "example.com"
      },
      "type": "hysteria2"
    },
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "dns-local",
    "final": "proxy",
    "find_process": true,
    "rules": [
      {
        "action": "sniff"
      },
      {
        "action": "hijack-dns",
        "protocol": "dns"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "domain": [
          "localhost"
        ],
        "domain_suffix": [
          "localhost",
          "local",
          "lan",
          "internal",
          "home.arpa"
        ],
        "outbound": "direct"
      }
    ]
  }
}
